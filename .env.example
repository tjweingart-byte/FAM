# Required: your Anthropic credentials.
# The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=sk-ant-...

# ...or don't put a key here at all. This file is the source that is lost every
# time the app is unpacked somewhere new, which is why the key kept being
# pasted again (PROBLEMS.md 53) and then pasted again on the next machine.
#
# FAM_SECRETS names a place the app can fetch its own credentials from, so a
# machine that has never run FAM needs this one line and nothing typed. It is
# not itself a secret: it says where the secrets are. Left unset, nothing
# changes and the three existing sources are used as before.
#
# One entry per line. file:<path> | file:NAME=<path> | cmd:<command> | cmd:NAME=<command>
# Output is read as a JSON object or as dotenv lines. Recipes for AWS, GCP,
# Vault, Doppler, 1Password and Docker secrets are in CREDENTIALS.md.
#
# FAM_SECRETS=cmd:aws secretsmanager get-secret-value --secret-id fam --query SecretString --output text

# Per-listener metering (METERING.md). The ledger is always written; this
# token is what lets anyone read it back over HTTP. Unset, /api/usage returns
# 404 rather than 401 - an unconfigured deployment should not advertise that it
# has a billing endpoint. tools/usage_report.py reads the database directly and
# needs no token.
#
# It also gates POST /api/admin/wipe, which takes the demonstration seed back
# out of a running deployment (DEPLOY.md). Same 404-rather-than-401 rule, and
# for a stronger reason: that endpoint deletes things. Unset is the safe
# default - an unconfigured deployment has no wipe endpoint at all.
# FAM_ADMIN_TOKEN=                    # python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The admin ACCOUNTS: the email, phone or listener id of each account that may
# open /admin (the live tracker) and every /api/admin endpoint while signed in
# to the app, comma separated. No token to paste. Unset means nobody is an
# admin by account.
# FAM_ADMIN_ACCOUNTS=you@example.com
#
# What the cost report ASSUMES, as opposed to what it reads off a provider's
# usage figures. These three only affect the GPU lines, which are an allocation
# rather than a bill - see METERING.md on why the fixed floor is reported
# separately and never folded into a per-listener average.
# GPU_USD_PER_HOUR=0.69               # RunPod serverless flex, 24 GB class
# SYNTHESIS_REALTIME_FACTOR=4.6       # Chatterbox speed, measured on an RTX 4090 (§75)
# GPU_HOURS_PER_DAY=24                # hours the card is actually paid for

# Several keys, comma separated, if you want failover when one is revoked or
# spend-capped mid demo. NOTE: Anthropic rate limits are per ORGANISATION, not
# per key, so a second key from the same org buys failover and no extra
# headroom.
# ANTHROPIC_API_KEYS=sk-ant-a,sk-ant-b

# HTTP transport. Some proxies and TLS-inspecting middleboxes break HTTP/2 to
# api.anthropic.com, which surfaces only as "Connection error". The client is
# pinned to HTTP/1.1; set to 1 (and `pip install h2`) to opt back into HTTP/2.
ANTHROPIC_HTTP2=0

# Model and research.
#
# These values are the settled defaults, and every one of them is a decision
# about the same thing: audio must start within about a second. Changing them
# is allowed; doing it by accident is what this file used to cause.
MODEL=claude-sonnet-5        # opus is slower to the first sentence
# EFFORT is further down, with the rest of what the opening costs.
# always | auto | never. Production is `always`: every episode is researched.
#
# `auto` reads the question instead - one that names a moving target,
# "latest", "today", "score", "breaking", is researched and everything else is
# answered from what the model already knows. That guess was worth making when
# research meant the model's own web_search tool at 10-25 seconds; with
# RESEARCH_BACKEND=parallel below it costs about half a second, and a guess that
# saves half a second while answering "who runs OpenAI" from stale memory is a
# bad trade. `never` is for offline work and benchmarks.
# A request can still say search=1 or search=0 and win.
SEARCH_MODE=always
MAX_WEB_SEARCHES=3

# ANSWER_FIRST, ANSWER_FIRST_SHARE and ANSWER_FIRST_MAX_SHARE are gone.
# They ran a second, tool-less model call that spoke from memory while the
# research was still reading, and handed over mid-episode. The half a listener
# heard first was the half that knew least: no brief, no evidence, written
# before anything had been looked up. Deleted rather than defaulted off -
# PROBLEMS.md §108, and Dockerfile.gpu for what a leftover knob does.
#
# How much hidden reasoning the writing call does before its first word.
# `low` at the owner's direction (PROBLEMS.md §129): at `high` this thinking
# is expected to be the largest wait on search (unmeasured; see §128). The writer still
# holds the brief and the evidence before it starts - only the thinking budget
# is smaller. /api/health reports which value is in force and where from.
# low | medium | high | xhigh | max
EFFORT=low
# The writer's own model (PROBLEMS.md §272): Haiku 5.5, at EFFORT. Not MODEL,
# which is in every episode's cache key and is what the composer, placer and
# thumbnails use. claude-sonnet-5 restores the Sonnet writer.
WRITER_MODEL=claude-haiku-5-5
#
# Prompt caching on the writer's instructions (PROBLEMS.md §179). The ~2,500
# tokens of house rules and style example are the same on every writer call,
# so they are marked cacheable: read at a tenth of the input price, and read
# sooner. Nothing sent or written changes. 0 sends the plain string.
# PROMPT_CACHE_TTL: 5m (write 1.25x) | 1h (write 2x, for sparse traffic).
PROMPT_CACHE=1
PROMPT_CACHE_TTL=5m
# The writer's cache warmed at the tap (§270): a searched episode whose writer
# has not run for five minutes sends a max_tokens=0 request beside its brief,
# so the writer's instructions are cached by the time it asks. 0 turns it off.
WRITER_WARM=1
# RESEARCH_MAX_TOKENS is gone with the model's own web search (PROBLEMS.md
# 135): nothing in FAM asks a model to search the web any more.

# Which generation pipeline a request runs through: legacy | phase6
#
# phase6 IS production, and is what you get with this variable unset. A
# character-bounded script buffer sits between the model reader and the voice,
# so synthesis falling behind can never stop the reader, and later sentences
# are batched into speech-sized chunks. The first chunk keeps its own latency
# path: the first complete speakable thought goes out immediately, with no word
# count and no batching delay.
#
# Validated on an RTX 4090 running this server, with Chatterbox and the real
# prompt - synthesis began before the model finished writing, playback stayed
# continuous with no gap reaching the listener, and the duration ceiling held.
#
# legacy is the older path: every sentence goes to the voice on its own,
# through a bounded queue the synthesiser drains, so a slow voice stops the
# model reading. It is kept for the baseline half of a comparison run and for
# the equivalence suite, and NOTHING selects it automatically - reaching it
# takes setting this line by hand, deliberately.
#
# An unrecognised value is refused at startup, and refused again at request
# time, rather than falling back to either: a typo that quietly picks a
# pipeline is the silent-success failure this project has paid for most.
STREAMING_PIPELINE=phase6

# Who does the looking when an episode is researched: parallel | perplexity | gdelt
#
# parallel IS the default (PROBLEMS.md 258): Parallel's Search API retrieves
# first and hands Claude an evidence packet to read, so the model reads rather
# than searches. perplexity, a second independent index, is the second look on
# a thin packet and the first rung below it.
#
# gdelt is the keyless one: an article index that needs no credential at all,
# so a deployment with no retrieval key still researches. Thinner than the web
# backends - titles, dates and grades, no passages - and it is evidence, which
# is the distinction that matters. It is also the floor whatever this is set
# to, once GDELT=1.
#
# claude is gone (PROBLEMS.md 135): the model never searches the web for FAM.
# A leftover RESEARCH_BACKEND=claude runs as parallel and says so at startup
# and on /api/health.
#
# Any other unrecognised value is refused at startup and again at retrieval
# time. The configured backend is the one that runs. Where it cannot serve,
# or comes back with nothing usable, one more search goes to the second look
# with the window dropped, and then the ladder (perplexity, gdelt) is tried -
# and the episode's own record says which one served it (fell_back_from). If
# every rung is empty the episode is still written (PROBLEMS.md 256), and the
# writer's rules keep anything volatile from being supplied from memory.
RESEARCH_BACKEND=parallel
# PARALLEL_API_KEY=...        # required unless RESEARCH_BACKEND is another one
# PERPLEXITY_API_KEY=...      # the second look and the backup; without it the
#                             # retry stays on the configured backend

# Where the one retry on a thin packet goes: another index (perplexity), or
# same to keep it on the configured backend. A backend with no key is skipped.
RESEARCH_SECOND_LOOK=perplexity
# How long one search may take before the ladder moves on, in seconds.
SEARCH_TIMEOUT_SECONDS=8
# Parallel's mode: fast ($1/1k, under a second), turbo, basic or advanced
# ($5/1k). Always sent - Parallel defaults to advanced when it is omitted.
PARALLEL_MODE=fast
PARALLEL_CHARS_PER_RESULT=4000
# Perplexity's search type: fast ($1/1k) or web ($5/1k).
PERPLEXITY_SEARCH_TYPE=fast
PERPLEXITY_TOKENS_PER_PAGE=1024
# The most one passage holds when a page's excerpt is cut up for the packet;
# short paragraphs are packed together up to it (PROBLEMS.md 286; was 500).
SEARCH_PASSAGE_CHARS=1000

# How much evidence a researched episode is handed: 10 results fetched, the
# top 6 in the packet, 3 passages each - every two-minute episode, so every
# myFAM, DailyFAM and Trending one (PROBLEMS.md 276 and 286; it was 3 x 2,
# about 3 KB, then 5 x 3). Episodes longer than 2 minutes get more (research.packet_size). The
# cost is prompt tokens, about a thousand more per researched episode, never
# another search. 3 and 2 restore the hand-measured 2026-09-05 benchmark.
SEARCH_NUM_RESULTS=10
SEARCH_PACKET_SOURCES=6
SEARCH_HIGHLIGHTS_PER_SOURCE=3

# Whether each source in the packet carries its publication date and a grade
# for how reliable its publisher is.
#
# On, and it is the cheapest quality fix in this codebase. The packet used to
# be a title and some highlights, so an episode was asked whether something
# happened last night or two days ago from evidence containing no dates at all.
# The search was already returning the date and the URL and the packet was
# discarding both. Recency is a filter (see EI_DEFAULT_RECENCY_DAYS) and credibility is
# the sort, so a question about last night is answered from last night, by the
# best-sourced report of it. Set to 0 only to reproduce the hand-measured
# 2026-09-05 benchmark, whose numbers were taken on the undated shape.
SEARCH_DATED_PACKET=1

# Whether a packet that misses what the brief asked for buys one more search.
#
# One, never more, and never a model call to rephrase it: the second search
# drops the recency window and searches the resolved subject. It costs about
# half a second and a fifth of a cent, and only on episodes that were going to
# be thin. A retry that also misses still uses its packet - half an answer
# beats none - and the writer is told which parts are thin rather than filling
# them from memory in the same confident voice.
RESEARCH_RETRY=1

# --- Episode intelligence ---------------------------------------------------
#
# The layer between the typed question and the search: it works out what is
# being asked, why it might be being asked now, how fresh the evidence has to
# be, what the episode must establish, what shape the story takes and how deep
# the chosen duration should go - and it does all of that BEFORE the search,
# so the one search FAM pays for is a search for the right thing.
#
# It costs one model call in front of the first word on the search path, which
# breaks CLAUDE.md's one-sentence spec. That was a deliberate decision: the
# writing is the product, and a fast episode about the wrong thing is worth
# less than a slower one about the right thing. The browse surfaces pay none of
# it - there the brief is built before the tap.
#
# Set to 0 for exactly the old behaviour: the raw query goes to the search, with no
# structure, no why-now and no temporal cautions. Nothing here can stop an
# episode being made - every failure falls back to the raw query and says so.
EPISODE_INTELLIGENCE=1
# Understanding a request is a small extraction, not the writing. Unset, this
# is Haiku 5.5 at medium effort (§261) and does not follow MODEL.
# EI_MODEL=claude-sonnet-5 with EI_EFFORT=low restores §249's brief.
# EI_MODEL=claude-haiku-5-5
EI_EFFORT=medium
# The brief's thinking and JSON share this; one that hits it degrades to the
# raw query (§248). /api/health -> episode_intelligence.since_boot counts how
# often that happens.
EI_MAX_TOKENS=3000
# A ceiling, not a target. Past this the brief is not worth the wait and the
# raw query is searched instead - EI must degrade to the old behaviour rather
# than become a new way for an episode to hang.
EI_TIMEOUT_SECONDS=8.0
# The same ceiling for briefs built before any tap - myFAM's prefetch, the
# DailyFAM and Trending editions (§268). Nobody is waiting, so they get room.
EI_AHEAD_TIMEOUT_SECONDS=30.0
# The brief as two calls at once (§268): one works out the request, the
# other words the searches and names the episode. 0 sends the single call.
EI_SPLIT=1
# Worked example briefs in the brief's cached instructions (§268). 0 sends
# the instructions alone, for comparing.
EI_EXAMPLES=1
# The plan of the piece as a third part of the split brief (§270): beats, the
# opening's slots and the ending, from the question alone, stating no fact.
# 0 sends the two parts. The grace is how long a searched brief waits for it
# once the other two are in.
EI_OUTLINE=1
EI_OUTLINE_GRACE_SECONDS=0.5
# Episode quality (§309). Every written episode is measured in code for
# nothing; the model grader reads it afterwards, never in front of a
# listener: off, ahead (prefetch, Trending, DailyFAM) or all. The grader is
# a stronger model than the writer (empty follows MODEL), capped per day.
# A node with fewer episodes than QUALITY_MIN_EPISODES is not ranked; the page
# points to its nearest ancestor that has enough.
QUALITY_GRADE=off
# QUALITY_GRADER_MODEL=
QUALITY_GRADER_EFFORT=medium
QUALITY_GRADE_DAILY=200
QUALITY_MIN_EPISODES=5
# The evidence cut to what the episode can use (§270): Haiku with thinking off
# picks which of the packet's sentences the writer reads - numbers only, never
# words of its own. Off until a --compare run says it shortens the writer's
# thinking. Every failure leaves the packet as it was.
EVIDENCE_DIGEST=0
EVIDENCE_DIGEST_MODEL=claude-haiku-5-5
EVIDENCE_DIGEST_TIMEOUT_SECONDS=2.5
EVIDENCE_DIGEST_AHEAD_TIMEOUT_SECONDS=15.0
EVIDENCE_DIGEST_MAX_TOKENS=1024
EVIDENCE_DIGEST_MIN_CHARS=2500
# The recency window applied to a question about a moment when the brief names
# no other. Wide enough to catch a story that broke over a weekend, narrow
# enough to keep a well-ranked two-year-old explainer out of the evidence for
# "what happened last night".
EI_DEFAULT_RECENCY_DAYS=14

# --- Live facts -------------------------------------------------------------
#
# The route around the article index, for the questions an index is
# structurally too slow for: a game ends and the scoreboard knows instantly,
# and the recap saying so is written, published and indexed later. In between,
# a search returns the *preview* - which is how FAM once wrote a final score
# for a game in its third quarter (PROBLEMS.md §88).
#
# Leave this on. With no provider configured it costs a dictionary lookup, and
# its whole effect is that the writer is told there is no live feed - which is
# the honest state, and the one that stops a score being invented. LIVE_FACTS=0
# silences even that and is for offline `write.py` runs.
LIVE_FACTS=1

# Which provider serves each domain. **Empty means none, and none is the
# shipped state** - no real provider has been connected, and `/api/health` says
# so rather than pretending. Setting a name this build does not know is
# reported loudly and still leaves the domain unserved; it never fails to boot.
#
# `fake` is a deterministic stand-in for tests, `./demo.sh` and
# `tools/ei_eval.py --only in-progress`. It reports INVENTED state and says so
# in its own name. Select it explicitly or not at all - never as a fallback,
# which is the rule placeholder audio and placeholder art already follow.
LIVE_SPORTS_PROVIDER=
LIVE_MARKETS_PROVIDER=
LIVE_ELECTIONS_PROVIDER=

# What the fake pretends is happening: scheduled, in_progress or final.
# LIVE_FAKE_SPORTS_STATUS=in_progress

# Ceilings, per provider and for the whole lookup. Small on purpose: this sits
# in front of the first word. A provider that cannot answer in a second and a
# half is one the listener should not be waiting for, and a dead one must cost
# a known slice of time-to-first-audio rather than the episode.
LIVE_TIMEOUT_SECONDS=1.5
LIVE_TOTAL_TIMEOUT_SECONDS=2.5
# How long the live lookup may run while the search beside it is still running
# (§265); past the evidence it gets only what is left of the ceiling above.
LIVE_PATIENT_SECONDS=8.0

# --- Local news and weather (§194) ------------------------------------------
# A question about one town is answered from its own outlets' RSS feeds,
# collected ahead of time, then its county's, then a web search limited to the town's
# outlets. Never GDELT. When the town has nothing, the episode says so in
# words composed in code, gives the weather there and the nearest news.
LOCAL_NEWS=1
LOCAL_NEWS_POLL_MINUTES=30
LOCAL_NEWS_WINDOW_DAYS=14
# How long a stored item is kept at all, pruned daily (§208); never below the window.
LOCAL_NEWS_KEEP_DAYS=30
# Weather: the US National Weather Service first (free, keyless), Open-Meteo
# everywhere else and when NWS fails. Open-Meteo's free endpoint is
# non-commercial, so production needs OPEN_METEO_API_KEY (the $29 plan) -
# set it in FAM_SECRETS or the production service only, never staging.
WEATHER=1
# A place's forecast is fetched when first asked about, then refreshed at these
# hours in the place's own time while it was asked about in the last 30 days.
WEATHER_SWEEP_HOURS=5,17
# US questions also ask NWS for the warnings in force at that moment (free).
WEATHER_LIVE_ALERTS=1
OPEN_METEO_KEYLESS=0
# OPEN_METEO_API_KEY=
# Who the feed collector and weather requests say they are (NWS requires one).
FAM_CONTACT_EMAIL=admin@familiarize.net

# How long one entity's state may be reused, by status. Keyed on the entity and
# never on the listener's wording, so three people asking about one game share
# one provider call. In-progress is short enough only to collapse a burst of
# simultaneous listeners; final does not move again.
LIVE_CACHE_IN_PROGRESS_SECONDS=10.0
LIVE_CACHE_SCHEDULED_SECONDS=300.0
LIVE_CACHE_FINAL_SECONDS=900.0

# --- World trending ---------------------------------------------------------
#
# The myFAM "Trending" row: what the *world* is paying attention to. Distinct
# from "What FAM can't stop playing", which is this app's own play counts over
# its own bank, and distinct again from live facts - one changes what is
# offered, the other what an episode says. See TRENDING.md.
#
# Leave on. With no source configured the row is honestly empty and says why,
# which is never the same as saying nothing is happening in the world.
TRENDING=1

# Empty means none, and none is the shipped state - no real feed is connected.
# `fake` is a deterministic stand-in for tests and demos; ask for it by name,
# never as a fallback.
TRENDING_SOURCE=

# One refresh serves every listener - that is this row's whole economics, and
# why it is the cheapest place in FAM to add live data. Fifteen minutes is
# about how fast a global news index actually moves.
TRENDING_TTL_SECONDS=900.0
# Generous, because this never sits in front of the first word: it refreshes
# in the background and myFAM renders from the cache.
TRENDING_TIMEOUT_SECONDS=8.0
TRENDING_MAX_ITEMS=6

# --- myFAM's story pool -----------------------------------------------------
#
# What "Made for you" and "Trending" are built from: live data turned into
# candidate episodes - a title and an angle, never a script. One sweep and one
# small model call per window serve every listener; the script is written when
# somebody taps a tile. See MYFAM.md.
#
# Leave on. With no source configured myFAM offers its evergreen bank and
# /api/health says which sources are missing and why, which is never the same
# as saying nothing is happening in the world.
STORIES=1

# Empty means every source this build knows, each of which reports itself as
# not configured when its credential is absent. Narrow it with a
# comma-separated list: gdelt, trending, finnhub, polymarket, balldontlie.
STORIES_SOURCES=

# One sweep and one composition serve every listener for this long - the whole
# economics of the browse page. The per-source floors in story_sources.py keep
# the providers with daily quotas off this clock. This is the tick: each
# source keeps its own floor (PROBLEMS.md 155).
STORIES_TTL_SECONDS=900.0
# How often the pool refreshes itself with nobody looking, for the news and
# market sources. Sports are swept on demand only (PROBLEMS.md 191). 0 leaves
# only the page-load trigger. PROBLEMS.md 135.
STORIES_BACKGROUND_SECONDS=900.0
# How often the slow sources - GDELT's news sweep, the trending registry and
# Polymarket - are asked. Sports and markets stay on the tick. PROBLEMS.md 155.
STORIES_NEWS_INTERVAL_SECONDS=7200.0
# Finnhub's floor: every two hours, round the clock - large moves are what
# matter (PROBLEMS.md 191).
STORIES_MARKETS_INTERVAL_SECONDS=7200.0
# A followed sport's sweep while one of its games is on (PROBLEMS.md 191).
STORIES_SPORTS_INTERVAL_SECONDS=900.0
# The sports sweep spends nothing unless somebody drew myFAM this recently.
STORIES_DEMAND_SECONDS=1800.0
# Generous, because this never sits in front of the first word: the pool
# refreshes in the background and myFAM renders from whatever it holds.
STORIES_TIMEOUT_SECONDS=12.0

# Whether a model writes the titles and angles. 0 gives templated tiles - what
# a deployment with no API key serves, and a real product rather than a
# placeholder.
STORIES_COMPOSE=1
# Unset follows MODEL (§249).
# STORIES_MODEL=claude-sonnet-5
STORIES_EFFORT=low
STORIES_MAX_TOKENS=6000
STORIES_COMPOSE_TIMEOUT_SECONDS=45.0

# --- The category tree: a vocabulary that grows itself ----------------------
#
# topics.py has always ranked in a hand-written vocabulary - eight facets and
# twenty-nine subtags, thirty-seven keyword lists somebody typed. There is no
# `nfl` tag and no `college-football` tag, both are `sports`, and no weighting
# can tell them apart because nothing in the vocabulary knows they differ.
#
# This is the other half. The sweep that refreshes the story pool also reads
# the event log for the subjects listeners actually searched for, and mints a
# node for anything enough *different* people used. The tree has no depth
# limit: sports -> american football -> nfl -> cincinnati bengals is four
# levels, and topics.tag_weight scores the leaf several times the root because
# it is several times more specific a claim about an episode.
#
# 0 leaves the hand-written vocabulary exactly as it was.
CATEGORIES=1
# Whether a model places a new subject in the tree. With this off - or with no
# API key - a subject still gets a parent, from the facet its own sightings
# were tagged with and from containment against the nodes already there. What
# it does not get is the levels nobody typed: "american football" and "nfl"
# exist only because a model named them, and no amount of reading what
# listeners wrote invents a level none of them wrote. Same shape as
# STORIES_COMPOSE: a deployment with no key gets a real, shallower vocabulary
# rather than a broken one, and every node records which produced it.
CATEGORIES_PLACE=1
# Unset follows MODEL (§249).
# CATEGORIES_MODEL=claude-sonnet-5
CATEGORIES_EFFORT=low
CATEGORIES_MAX_TOKENS=4000
# A ceiling, not a target. Nobody waits on this: the tree that exists is used
# and the new subjects are placed on the next sweep.
CATEGORIES_PLACE_TIMEOUT_SECONDS=30.0
# How far back the promotion sweep reads. Long enough that a subject somebody
# was interested in last month still counts toward the listener threshold,
# short enough that the vocabulary tracks what people are asking about now.
CATEGORIES_WINDOW_DAYS=45
#
# Where the tree is kept. Commented out for the same reason as every other
# database path: the working default is derived from the project root, and a
# deployment points it at the mounted disk.
# CATEGORIES_DB=/data/categories.db
# TRENDING_BANK_DB=/data/trending_bank.db

# --- Thumbnails: one picture per branch of the category tree (§160) --------
#
# THUMBNAILS.md is the whole of it. A picture is painted by Gemini's image
# model, matching the reference pictures in THUMBNAILS_STYLE_DIR, from a scene
# Claude wrote with every team, company and person name taken out, and is then
# checked by Claude for logos, text, faces and real products before it goes
# live.
#
# Whether the background sweep paints nodes that have no picture. Serving the
# pictures that exist is always on; tools/thumbnails.py and /admin/thumbnails
# can paint with this off.
THUMBNAILS=0
# Google AI Studio key with the Gemini API enabled and billing on.
# GEMINI_API_KEY=...
# Gemini 3.1 Flash Image; Imagen 4 was shut down on 2026-08-17 (§164).
THUMBNAILS_IMAGE_MODEL=gemini-3.1-flash-image
THUMBNAILS_IMAGE_PRICE=0.067
# The house style's reference pictures, sent with every image request (§166).
# 0 sends none and the words of HOUSE_STYLE carry the look alone.
# THUMBNAILS_STYLE_DIR=thumbnail_style
# The model that writes scenes and checks pictures, and its list prices for
# the spend record. Unset follows MODEL (§249); change all three together.
# THUMBNAILS_MODEL=claude-sonnet-5
THUMBNAILS_CLAUDE_INPUT_PER_MTOK=2.0
THUMBNAILS_CLAUDE_OUTPUT_PER_MTOK=10.0
# Paintings per node, and what `plan` budgets. 1 (§169): a picture that fails
# a check is held for review in /admin/thumbnails rather than paid for again.
THUMBNAILS_ATTEMPTS=1
THUMBNAILS_EXPECTED_ATTEMPTS=1.0
# Ceiling on images requested per rolling day, across the whole deployment.
THUMBNAILS_DAILY_IMAGES=60
THUMBNAILS_PER_SWEEP=20
THUMBNAILS_WRITER_BATCH=25
THUMBNAILS_TIMEOUT_SECONDS=120.0
# flagged: a clean picture of a real named thing (a team, a company) waits for
# a person in /admin/thumbnails. all: every picture waits. none: the checker's
# word is enough.
THUMBNAILS_REVIEW=flagged
# THUMBNAILS_DB=/data/thumbnails.db
# Requests per outside service per day, for the admin page (PROBLEMS.md §179).
# PROVIDER_USAGE_DB=/data/provider_usage.db
# LIVE_ROUTING_DB=/data/live_routing.db
# What went wrong in the pipeline, for /admin (PROBLEMS.md §269).
# PIPELINE_ERRORS_DB=/data/pipeline_errors.db
# Every written episode's quality, for /admin/quality (PROBLEMS.md §309).
# EPISODE_QUALITY_DB=/data/episode_quality.db
# Conversations on X waiting for a person, for /admin/x (PROBLEMS.md §311).
# X_THREADS_DB=/data/x_threads.db
# Local news outlets, their collected stories and resolved places (§194).
# LOCAL_NEWS_DB=/data/local_news.db

# How far a price has to move before it is worth an episode.
STORIES_MARKET_MOVE_PERCENT=3.0
# Polymarket is keyless, so without this it would switch itself on - and on a
# fresh deployment it would be the only live source, which would make the
# browse page a betting slip. Off until a deployment asks for it.
STORIES_POLYMARKET=0
# The symbols Finnhub is asked about each sweep. Empty is the named list in
# story_sources.WATCHLIST.
FINNHUB_WATCHLIST=

# --- GDELT: a second index, and the story pool's news ----------------------
#
# Keyless. Read from GDELT's 15-minute export files, never its search API
# (§211): one background job downloads each new file - ~200 requests a day,
# whatever the traffic - and the story sweep, the theme volumes and an
# episode's fallback search all read the copy on disk. No listener's tap ever
# reaches GDELT, so its per-address limit no longer applies.
#
# Ships OFF: the build container's egress blocks the host, so nothing here has
# downloaded a real file. Turn it on somewhere with network, run
# `python tools/gdelt_probe.py`, and leave it on once that passes.
GDELT=0
GDELT_CROSS_CHECK=0
GDELT_MAX_RECORDS=20
GDELT_EXPORT_BASE=http://data.gdeltproject.org/gdeltv2
GDELT_EXPORT_POLL_SECONDS=900.0
# Polls land this far past each quarter hour, on GDELT's clock (§220); a
# named file not served yet is looked for again after WAIT; a timeout, a
# dropped connection or a 5xx is asked once more after RETRY.
GDELT_EXPORT_POLL_OFFSET_SECONDS=450.0
GDELT_EXPORT_WAIT_SECONDS=120.0
GDELT_EXPORT_RETRY_SECONDS=10.0
GDELT_EXPORT_TIMEOUT_SECONDS=120.0
# How much news the copy holds, and how many articles per file are kept (the
# theme volumes count every article). Sized for the shared 1 GB disk.
GDELT_EXPORT_KEEP_HOURS=24.0
GDELT_EXPORT_ROWS_PER_FILE=1500
# Files fetched behind the newest when the copy is behind (a boot, an outage).
GDELT_EXPORT_BACKFILL_FILES=8
# Syncs a file may fail in before it is written off, and quick looks a file
# named but not yet served gets (10.16 #4): without them one broken file was
# asked twice at every poll for two hours.
GDELT_EXPORT_FILE_TRIES=3
GDELT_EXPORT_MAX_WAITS=2
# GDELT's export copy (§211).
# GDELT_EXPORT_DB=/data/gdelt_export.db
# The story pool and its ledgers, saved after every refresh (§267).
# STORY_POOL_DB=/data/story_pool.db

# --- The reference look: Wikipedia and Wikidata (§278) ----------------------
#
# When the brief names a person or organisation, its Wikipedia summary and
# Wikidata's facts (date of birth and an age computed in code, positions with
# no end date) join the evidence as one extra source after the web sources -
# background, never a current state. Never on an outcome-dependent, weather or
# local question. 0 turns it off.
WIKIPEDIA=1
# Wikimedia Enterprise's On-demand API, preferred when set (a free account is
# 50,000 requests a month). Unset: Wikipedia's keyless summary only.
# WIKIMEDIA_ENTERPRISE_USERNAME=
# WIKIMEDIA_ENTERPRISE_PASSWORD=
# Enterprise requests per calendar month (UTC) before the keyless summary
# takes over; counted in wikimedia.db, so a restart does not reset it.
WIKIMEDIA_MONTHLY_REQUESTS=45000
# One request to Wikimedia, and how long past the main search the reference
# may still arrive (it never holds the first word longer than that).
WIKIPEDIA_TIMEOUT_SECONDS=2.0
WIKIPEDIA_GRACE_SECONDS=0.5
# Each name's answer for a day, and Enterprise's monthly count (§278).
# WIKIMEDIA_DB=/data/wikimedia.db

# --- The history archive (§308, ARCHIVE.md) ---------------------------------
#
# Every written episode's articles are kept for the Database inventory
# specialist to digest (docs/FAM_AGENTS.md), with each episode's source list;
# the facts it keeps are recalled beside the search as dated earlier
# reporting. Never a private search or an attachment. 0 turns it off.
ARCHIVE=1
# sqlite (the local file below; tests, staging, a fresh clone) or atlas
# (MongoDB Atlas). atlas needs MONGODB_URI - through FAM_SECRETS, never typed
# into a file - and pymongo (requirements-archive.txt); without them the
# archive is off and /api/health says why.
ARCHIVE_BACKEND=sqlite
# MONGODB_URI=
ARCHIVE_DB_NAME=fam
ARCHIVE_TIMEOUT_SECONDS=2.0
# The recall beside the search: how long past the main packet it may arrive,
# how many facts it may add, how close (cosine) a fact must be.
ARCHIVE_RECALL=1
ARCHIVE_GRACE_SECONDS=0.5
ARCHIVE_RECALL_LIMIT=6
ARCHIVE_MIN_SIMILARITY=0.45
# Undigested articles kept before the oldest are dropped.
ARCHIVE_INTAKE_MAX=500000
# ARCHIVE_DB=/data/archive.db

# How far apart boot's background jobs start (§144): the story sweep at once,
# the trending bank one stagger later, the DailyFAM edition two. 0 starts them
# in the same second, which is what timed EI out on 24/09.
BOOT_STAGGER_SECONDS=60

# --- The DailyFAM edition (§143, daily_edition.py) ----------------------------
#
# Every DailyFAM episode is written in the background before it is tapped: at
# these hours, one per distinct subject across every mix, dated for the day.
DAILY_EDITION=1
DAILY_EDITION_TIMEZONE=America/New_York
DAILY_EDITION_HOURS=5
# "Your mix is ready" at a mix's listen time (push.py). Web Push needs a VAPID
# key pair - `python tools/vapid_keys.py` prints one - and
# `pip install -r requirements-push.txt`. Without them listen times are kept
# and the interface says notifications are not set up yet. 0 turns it off.
MIX_REMINDERS=1
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Required with the keys: a mailto: or https: contact push services can reach.
# VAPID_SUBJECT=mailto:you@example.com
# Email (mail.py, PROBLEMS.md §244): password reset by a code sent to the
# account's address. Any SMTP provider - Resend, Postmark, Amazon SES, Gmail.
# Port 587 is STARTTLS, 465 implicit TLS. MAIL_FROM must be an address the
# provider has verified. Without SMTP_HOST and MAIL_FROM there is no reset and
# the log-in screen draws no "Forgot password?".
# SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# MAIL_FROM=FAM <hello@yourdomain.com>
# Both editions (DailyFAM, Trending) send their writer calls through the
# Message Batches API at half price (PROBLEMS.md §179). A batch not ended
# within EDITION_BATCH_WAIT_SECONDS is cancelled and the rest written live.
# 0 writes every edition episode live, as before.
EDITION_BATCH=1
EDITION_BATCH_WAIT_SECONDS=3600
EDITION_BATCH_POLL_SECONDS=30
# The editions' own writer (PROBLEMS.md §269): Trending and DailyFAM only,
# so a cheaper writer is tried where nobody is waiting. Unset, they write on
# WRITER_MODEL / EFFORT. Not in the cache key: a tap hears what the edition wrote.
# EDITION_WRITER_MODEL=claude-haiku-5-5
# EDITION_WRITER_EFFORT=low
DAILY_EDITION_MAX_EPISODES=300
DAILY_EDITION_MAX_DOLLARS=15.0
DAILY_EDITION_RETRY_SECONDS=1800.0

# --- Conversations on X (§311, x_threads.py, /admin/x) -----------------------
#
# A read-only X API bearer token lets /admin/x find threads one of FAM's
# episodes could add to. A person approves each reply and posts it in X;
# FAM never posts. Unset, the page says so. X bills per post read.
# X_BEARER_TOKEN=
X_THREADS_MAX_READS=300
X_THREADS_DAILY_READS=600
X_THREADS_WINDOW_HOURS=6.0
X_THREADS_SEEDS=10
# X_THREADS_MODEL=claude-haiku-5-5

# --- The trending bank (§139, trending_bank.py, TRENDING.md) ------------------
#
# Trending is an edition: built at 05:00 and 17:00 Eastern for every listener
# from GNews and nothing else, its episodes written ahead of the tap. With
# GNEWS_KEY unset, Trending is empty and says so - there is no fallback.
TRENDING_BANK=1
TRENDING_BANK_SIZE=10
TRENDING_BANK_TIMEZONE=America/New_York
TRENDING_BANK_HOURS=5,17
TRENDING_BANK_WRITE=1
# Write the eight "Start here" questions at each edition slot too, so their
# cards name what they turned out to be about (9.29 packet). Needs no GNews key.
STARTUP_WRITE_AHEAD=1
TRENDING_BANK_RETRY_SECONDS=1800.0
TRENDING_BANK_MAX_AGE_HOURS=36.0
# GNEWS_KEY=
GNEWS_LANG=en
GNEWS_CATEGORIES=general,world,nation,business,technology,entertainment,sports,science,health
GNEWS_COUNTRIES=us,gb,ca,au,in
# 10 is the free plan's maximum per request; Essential allows 25.
GNEWS_MAX_ARTICLES=10
GNEWS_CORROBORATE=12
GNEWS_TIMEOUT_SECONDS=10.0
GNEWS_REQUEST_GAP_SECONDS=1.2
# The app's own ceiling, below the plan's: 90 for free (100/day), 900 for
# Essential (1,000/day). One edition is about 26 requests with these defaults.
GNEWS_DAILY_REQUESTS=90
# The plan bought on gnews.io (§207): free | essential | business | enterprise.
# Free is for development only; /admin flags it while GNews is in use. On
# Essential also raise GNEWS_DAILY_REQUESTS to 950 and GNEWS_MAX_ARTICLES to 25.
GNEWS_PLAN=free

# --- Live provider credentials ----------------------------------------------
#
# One per vendor, empty by default. Empty means "not configured", which
# /api/health reports as its own state - never as "there is no live
# information in the world". Never write a key into source: these go in
# ~/.fam/env or whatever FAM_SECRETS points at. See CREDENTIALS.md.
#
# Sports. BALLDONTLIE is the only sports provider (PROBLEMS.md 277, 280;
# SportsDataIO was removed in 262): one
# flat-rate key for every league it covers - games, standings, last and next
# games, Formula 1, UFC - and the myFAM sweep's live scores.
# LIVE_SPORTS_PROVIDER=balldontlie
# Unset, and BALLDONTLIE_API_KEY present, means balldontlie: the key is the
# statement of intent (PROBLEMS.md 135). `none` switches a domain off. The same
# goes for FINNHUB_KEY and markets.
#
# Player and team reports (PROBLEMS.md 275): a player's season figures and
# the league's injury report, beside the scoreboard, for every league
# BALLDONTLIE covers. The key is the switch; PLAYER_FACTS=0 turns it off.
PLAYER_FACTS=1
# BALLDONTLIE_API_KEY=
# The plan bought on balldontlie.io: free | all-star | goat. Free reads
# players and teams only; injuries and season figures need ALL-STAR, and
# soccer injuries and golf and tennis figures GOAT. An endpoint above the
# plan is never asked.
BALLDONTLIE_TIER=free
# Leagues an unplaced name is searched in, in order (empty: the built-in
# order, NBA, NFL, MLB, NHL, Premier League ...), and how many of them.
BALLDONTLIE_LEAGUES=
BALLDONTLIE_MAX_SEARCHES=4
# How long one player's or team's report is reused, in seconds.
BALLDONTLIE_CACHE_SECONDS=900
# The API's address; changed only to point at a stand-in.
BALLDONTLIE_BASE=https://api.balldontlie.io
#
# API-Sports' free plans while developing (PROBLEMS.md 290, temporary - deleted
# when FAM goes commercial). One key from dashboard.api-football.com covers
# every sport. With it set, every league api_sports.LEAGUES maps (NFL, college
# football, NBA, WNBA, men's college basketball, MLB, NHL, the five European
# leagues, the Champions League, MLS, the World Cup) is answered by API-Sports
# while BALLDONTLIE is absent or on its free plan; API_SPORTS_LEAGUES names the
# leagues instead (BALLDONTLIE keys, comma-separated). Formula 1, UFC, player
# figures and injuries stay BALLDONTLIE's. The free plan limits which seasons
# it serves: a refused season is said on /admin, never read as no games.
# API_SPORTS_KEY=
API_SPORTS_LEAGUES=
# The free plan is 100 requests a day per sport (reset 00:00 UTC) and about 10
# a minute. The myFAM sweep stops while the reserve is left for listeners.
API_SPORTS_DAILY_REQUESTS=100
API_SPORTS_PER_MINUTE=10
API_SPORTS_LOOKUP_RESERVE=40
#
# Markets. Finnhub's free tier is 60 req/min and about 20 minutes delayed -
# which is fine here, because `delayed_seconds` makes the prompt say delayed
# rather than current. A monetised FAM needs Finnhub's commercial plan (Alpha
# Vantage was removed, PROBLEMS.md 262).
# LIVE_MARKETS_PROVIDER=finnhub
# FINNHUB_KEY=
# The plan bought on finnhub.io (§207): free | commercial. Free is personal /
# non-commercial use only; /admin flags it while Finnhub is in use.
FINNHUB_PLAN=free
#
# Tiingo's free plan while developing (PROBLEMS.md 290, temporary). With the key
# set, markets are Tiingo's (ahead of Finnhub) unless LIVE_MARKETS_PROVIDER
# names one: a quote from IEX's last sale and Tiingo's ticker search, the
# watchlist swept in one request. Free is 50 requests an hour, 1,000 a day and
# 500 tickers a month, personal use only (/admin flags it); FAM stops below.
# TIINGO_API_KEY=
TIINGO_HOURLY_REQUESTS=45
TIINGO_DAILY_REQUESTS=950
TIINGO_PLAN=free
#
# Elections. Polymarket is keyless and is a FORECAST, never a result - every
# fact it returns carries kind=prediction-market and status=unknown, which is
# what stops a market price closing an outcome-dependent question. AP and DDHQ
# are the real result feeds; both are sales-gated with no public pricing, so
# both are declared and unimplemented rather than guessed at.
# LIVE_ELECTIONS_PROVIDER=polymarket
# AP_ELECTIONS_KEY=
# DDHQ_KEY=
POLYMARKET_BASE=https://gamma-api.polymarket.com

# --- Prefetch ---------------------------------------------------------------
#
# Writing the episode before anybody asks for it. CLAUDE.md has said from the
# beginning that latency is answered by *starting earlier* rather than by
# filling the gap, and the browse surfaces are where that is possible: myFAM
# and DailyFAM know what somebody might tap before they tap it.
#
# **On, and what is on is the cheap half.** It shipped off on the tier
# system's reasoning - the mechanism ready, the policy decided with numbers -
# and PREFETCH_LEVEL below is what makes switching it on safe: a brief is one
# small model call, so a wrong guess costs a fraction of a cent rather than a
# script nobody hears. myFAM schedules a cycle when it is drawn, the ceilings
# below bound it, and /api/health reports the hit rate per source, so "how
# much to prefetch" is still a measurement. PREFETCH=0 restores the old
# behaviour exactly: every tap pays for its own brief.
PREFETCH=1
# brief | script - how much is paid in advance.
#
# `brief` runs contextual relevance (episode intelligence) only and keeps the
# result: one small model call, and it removes the seconds EI costs. The tap
# still pays retrieval and writing. `script` writes the whole episode, so the
# tap pays nothing at all and a wrong guess costs a full episode. Starting at
# `brief` buys most of the felt improvement for a fraction of the waste, which
# is the right place to start with no hit rate in hand.
PREFETCH_LEVEL=brief
# How many candidates one cycle may warm, shared across sources rather than
# per source - they are interleaved so that no single source can take the
# whole budget and leave no evidence about the others.
PREFETCH_PER_CYCLE=6
# A hard daily ceiling in two currencies, because they fail differently: the
# count stops a runaway loop, the dollars stop a *correct* loop being
# expensive. A 10-minute researched episode costs several times a 1-minute
# one, so counting episodes alone does not bound the bill.
PREFETCH_DAILY_EPISODES=50
# Briefs are counted apart from episodes, and have a ceiling of their own
# because they cost a fraction of one. Counting a brief as an episode would
# make 50 briefs the whole day's warming - six per cycle, one cycle per browse
# - and the shipped level would switch itself off with most of the dollar
# budget unspent. The dollars below still bound both.
PREFETCH_DAILY_BRIEFS=400
PREFETCH_DAILY_DOLLARS=2.0
# How long the server must have gone without generating for a real listener
# before it will spend on a guess. A speculative episode that delays a real
# one has inverted the entire point of prefetching.
PREFETCH_QUIET_SECONDS=20.0
# The shortest gap between two cycles warmed for the same listener. A browse
# page is drawn often - opening the tab, coming back from a player - and
# without a clock on it one listener flicking between tabs would spend the
# whole daily ceiling on the same six tiles.
PREFETCH_CYCLE_SECONDS=300.0
# How long a warmed brief stays usable. A brief is a claim about *now* - a
# why-now hypothesis and a recency window built this morning are wrong by this
# evening - and a stale brief is worse than none, because it would make the
# episode confidently about the wrong day.
PREFETCH_BRIEF_TTL_SECONDS=3600.0

# How much audio must exist before the response starts, in seconds.
#
# A quantity, not a delay. At TARGET_WPM=150 this is 3.75 words, so any
# ordinary opening sentence satisfies it on the first chunk and it costs
# nothing; it only forces a second synthesis when the opening is very short.
# It exists because models stream in bursts, and because it is the last point
# at which a failed generation can still become an error rather than a silent
# empty episode.
#
# Must be greater than zero: at zero a streamed WAV's 44-byte header alone
# satisfies the gate and every episode is refused as empty.
PREROLL_SECONDS=1.5

# Where voice models live. Defaults to ~/.fam/voices, shared by every version of
# the app, so a new copy of the project does not re-download them.
# FAM_VOICES_DIR=~/.fam/voices

# Development override only. Leave it on auto in any deployment.
#
# Production does not choose a speech engine any more: there is one production
# slot (tts.PRODUCTION_ENGINES), which Chatterbox will fill. `auto` means "the
# production engine, or the interim one while that slot is empty" - and
# /api/health says which of those you are hearing.
#
# The other values name a development engine for deterministic local work:
# espeak | say | debug. None of them is a production voice: espeak and macOS
# `say` exist only if the host OS happens to provide them, which is how a
# deployment ends up sounding worse than the laptop it was built on, and
# `debug` is a tone. Piper used to be listed here as an interim voice and has
# been removed entirely - engine, package and dependency.
TTS_ENGINE=auto

# Chatterbox, FAM's production voice.
#
# Where it runs: auto | cuda | mps. `auto` picks cuda, then mps, and refuses
# cpu - Chatterbox on a CPU is slower than speech, so the episode would starve
# and the listener would hear gaps.
CHATTERBOX_DEVICE=auto
#
# The recording it clones. Blank means reference_3.wav in the shared voice
# folder (~/.fam/voices). It is somebody's voice, so a rights record must sit
# beside it - reference_3.rights.json - clearing consent, commercial_use and
# synthetic_voice_cleared. Without it the engine reports unavailable and
# /api/health says `interim: true` - which now means no voice at all, only a
# placeholder tone. There is no second engine to fall back to.
# CHATTERBOX_REFERENCE=~/.fam/voices/reference_3.wav
#
# Seed each chunk from the voice and its words, so a sentence sounds the same
# every time it is spoken and the accent is not re-rolled chunk by chunk
# (PROBLEMS.md §176). 0 restores unseeded sampling.
CHATTERBOX_SEEDED=1
# A seeded sentence that comes out wrong comes out wrong every time; change
# this to any other word to re-roll every sentence (blank is the default roll).
# CHATTERBOX_SEED_SALT=
#
# The sha256 of the one recording every voice worker must hold - printed by
# `python tools/pack_for_pod.py`. Set, a worker cloning a different file is
# refused (and says so on /api/health) instead of quietly changing the voice.
# VOICE_REFERENCE_FINGERPRINT=

# Which machine speaks: chatterbox | remote.
#
# `chatterbox` is the card in this process. It is the default, and the default
# is deliberate: a rented GPU must never become what every listener gets just
# because nothing local was installed. Nothing auto-detects - a deployment that
# wants the remote voice says so.
#
# `remote` is the same Chatterbox on a GPU somewhere else, reached over HTTP,
# so the app can run on cheap CPU hosting. Same weights, same reference
# recording, same generation settings: this changes where the card is and what
# it costs, not what a listener hears. See REMOTE_VOICE.md.
VOICE_BACKEND=chatterbox

# --- The remote voice. Only read when VOICE_BACKEND=remote. -----------------
#
# The transport, and the only difference between the two ways to rent the same
# card: runpod | http.
#
#   runpod  RunPod Serverless. Sleeps when idle, billed per second of
#           execution. Cheaper below a few hours of audio a day; pays a cold
#           start when it has scaled to zero, which the app hides by asking
#           for a worker while Claude is still writing.
#   http    An always-on pod running voice_worker/server.py. Never cold,
#           billed per hour whether it speaks or not.
#
# One worker image serves both (Dockerfile.voice), so switching is this line
# plus the endpoint below - never a rebuild and never a code change.
REMOTE_VOICE_TRANSPORT=runpod
#
# transport=runpod: the endpoint id from the RunPod console. The API key goes
# through the credential chain like every other secret - set it in the host's
# dashboard or in FAM_SECRETS, never here. See CREDENTIALS.md.
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=              # never in this file; the dashboard or FAM_SECRETS
#
# transport=http: the pod's base URL, and the shared secret it checks. An
# exposed port with no token is somebody else's free TTS service billed to your
# pod, so set one.
#
# The port in that URL must be the port the worker is listening on, and the
# container serves ${PORT:-8001} - so a pod exposing 8002 needs PORT=8002 in
# its environment too, and VOICE_WORKER_MODE=http, or nothing opens a port at
# all. Both failures arrive as a 404 on /synth that looks like a missing route.
# `python tools/probe_remote_voice.py --url <that URL>` says which. PROBLEMS §78.
# REMOTE_VOICE_URL=https://<pod-id>-8001.proxy.runpod.net
# REMOTE_VOICE_TOKEN=          # never in this file; the dashboard or FAM_SECRETS
#
# The rate the worker's model emits. 24000 is Chatterbox's. It has to be right
# before the first request: the stream header is written from it before any
# audio has been asked for, and the engine refuses a reply that disagrees
# rather than playing it at the wrong pitch.
REMOTE_VOICE_SAMPLE_RATE=24000
#
# A ceiling on the worst case, not a target: container boot plus a ~10s model
# load plus the synthesis. A warm worker answers a chunk in a couple of seconds.
REMOTE_VOICE_TIMEOUT=180.0
REMOTE_VOICE_CONNECT_TIMEOUT=10.0
#
# Chunks in flight at once. In-process Chatterbox is pinned at one because a
# single card cannot run concurrent generations safely; a remote backend that
# fans out across workers is not.
REMOTE_VOICE_CONCURRENCY=4
#
# Don't send a second wake within this many seconds - a worker that is already
# booting does not boot faster for being asked twice.
REMOTE_VOICE_WAKE_INTERVAL=60.0

# --- Finding the worker, instead of being told where it is ------------------
#
# The address of a rented GPU is not a constant. RunPod replaces a pod and it
# comes back somewhere else; the app is still holding the old address, and the
# only symptom is a 404 in the middle of somebody's episode. Keeping the two
# in agreement by editing a dashboard is the chain PROBLEMS.md §112 is about.
#
# `voice_control.py` walks a ladder instead - REMOTE_VOICE_URL, then workers
# that registered themselves, then pods found through RunPod's own API, then
# the serverless endpoint - verifies a rung with a real call before a listener
# is sent to it, and switches when one stops answering. Every rung is the same
# worker image speaking the same voice: what moves is the address.
#
# auto | off. `off` is the behaviour before the ladder existed: the configured
# address, nothing discovered, no failover. A debugging switch, not a
# deployment choice.
VOICE_DISCOVERY=auto
#
# The shared secret a worker presents to say where it is. **Unset means
# registration is refused**, not open - an endpoint that takes "the voice is
# at this URL" from anybody hands every script FAM writes to a machine of
# their choosing. Set the same value here (or in FAM_SECRETS) and on the pod,
# with FAM_APP_URL pointing at this app, and a replaced pod is back in service
# within one heartbeat with nothing edited.
# VOICE_REGISTRY_TOKEN=        # never in this file; the dashboard or FAM_SECRETS
#
# The pod to look for through RunPod's API, by **name or id** (comma separated
# for more than one). A name survives a pod being destroyed and recreated from
# the same template; an id does not, which is why the name is the thing to
# set. Needs RUNPOD_API_KEY, which is already set for the serverless transport.
# RUNPOD_POD=fam-voice
# Asked in this order: REST v2 (long-term support), REST v1 (retired by
# RunPod on 2026-11-15), GraphQL (rate limited from 2026-10-27, retired
# January 2027). See docs/SCALING_TIMELINE.md.
RUNPOD_API_URL=https://api.runpod.io/v2
RUNPOD_REST_URL=https://rest.runpod.io/v1
RUNPOD_GRAPHQL_URL=https://api.runpod.io/graphql
#
# The port inside the worker container. RunPod's proxy URL is built from it,
# and a mismatch is the 404 that reads exactly like a missing route (§78).
VOICE_WORKER_PORT=8001
#
# Whether a worker reached over plain HTTP may be used at all.
#
# Off, because the bearer token and every sentence of the script ride on that
# connection in clear. It exists because the alternative turned out to be
# worse (PROBLEMS.md §117): RunPod's proxy is the only TLS address a pod has,
# and that proxy is Cloudflare, which serves a browser and refuses a server -
# so `https://<pod>-8002.proxy.runpod.net/health` is 200 in a tab and 403
# from Render, with nothing wrong on either machine. On a pod the choice is
# therefore a raw TCP port or no voice at all, and this is where that choice
# is made rather than discovered.
#
# It widens nothing on its own: a plain address is still verified like any
# other and the token still has to match. Set it, expose the worker's port as
# a TCP port on the pod, and the app reaches the worker with no edge in the
# path - found through RUNPOD_POD or announced by the worker itself.
VOICE_ALLOW_PLAIN_HTTP=0
#
# How long a registration is offered without being renewed - five missed
# heartbeats - and how long a verified endpoint is used before it is checked
# again. The synth path pays nothing inside that second window.
VOICE_REGISTRY_TTL=300.0
VOICE_VERIFY_TTL=120.0
#
# How often the background check runs, so a pod that died at 3am is known at
# 3am rather than by the first listener at 9. 0 switches the loop off; the
# request path still resolves on demand.
VOICE_SUPERVISE_SECONDS=60.0
#
# A ceiling on one control-plane probe, and how long a failed endpoint is
# sorted to the back of the ladder. It is never dropped: if it is all there
# is, a stale failure must not be the reason nobody can speak.
VOICE_PROBE_TIMEOUT=8.0
VOICE_RETRY_SECONDS=60.0
#
# Where the registry of self-registered workers is kept. Commented out for the
# same reason as every other database path: the working default is derived
# from the project root, and a deployment points it at the mounted disk.
# VOICE_REGISTRY_DB=/data/voice_registry.db
#
# The bank of voices (§147, voice_bank.py): each voice's reference recording
# and rights record, and each listener's chosen search voice. Add voices with
# `python tools/voice_bank.py add`.
# VOICE_BANK_DB=/data/voice_bank.db

ESPEAK_VOICE=en-us

# Shared script cache: different people asking the same thing reuse one script.
CACHE_ENABLED=1
CACHE_BACKEND=sqlite         # sqlite (shared by all workers) | memory
# Every cached episode is kept for a week and stamped with when its
# information was sourced (§143). Kept is not current: a request that would
# write an episode is served only one still inside its current window below.
CACHE_LIFE_SECONDS=604800    # how long any episode is kept
CACHE_TTL_SECONDS=604800     # how long an evergreen episode stays current
CACHE_TTL_VOLATILE=7200      # how long a "latest"/"today"/upcoming-game one stays current (§173)
# How long an ordinary (evergreen) episode may be kept alive by being played
# (§134). Each play of one pushes its expiry a full CACHE_TTL_SECONDS forward,
# so an episode people keep listening to keeps its script *and its stored
# audio* instead of being re-voiced on RunPod every day - up to this age from
# when it was written. Volatile and scheduled episodes never slide. 0 = off.
CACHE_MAX_AGE_SECONDS=2592000
CACHE_SEMANTIC_KEY=0         # 1 = use a small model to match phrasings better
# On by default since §107: measured at 23 of 41 re-phrasings finding an
# existing episode against 9 without, no false match at any threshold, and
# 8.93 ms of local scanning on the miss path with no model call anywhere.
# `0` restores the old behaviour exactly.
CACHE_VECTOR=1               # 1 = also match near neighbours, not just the identical question
CACHE_VECTOR_THRESHOLD=0.68  # cosine a near match must clear (tools/bench_vector_cache.py)
CACHE_VECTOR_OVERLAP=0.6     # and the share of words it must literally share
# Keep each episode's audio beside its script so a cached episode replays from
# the database and never reaches the voice GPU again (§132). 0 = re-synthesise.
AUDIO_CACHE=1
# Ceiling for kept audio's hot copy, least recently played out first. Unset:
# 512 with the stores on the disk, 128 in Postgres (§252). 0 = none.
# AUDIO_CACHE_MAX_MB=512
# §237: how kept audio is packed and where it lives. AUDIO_CODEC=zlib
# restores §132's packing; AUDIO_STORE="" keeps audio in scripts.db.
AUDIO_CODEC=opus
AUDIO_OPUS_BITRATE=24000
# §242: Opus to clients that ask for it (fmt=opus); 0 = always PCM.
AUDIO_STREAM_OPUS=1
# §252: replays read straight from the R2 bucket by a signed link (the
# player asks with link=1; first plays still stream). 0 = always stream.
AUDIO_LINKS=1
AUDIO_LINK_SECONDS=300
AUDIO_STORE=
AUDIO_BUCKET=
R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: through FAM_SECRETS, never here.
AUDIO_RECENT_DAYS=7          # every episode's audio; then kept only if saved, shared or vibed
# Near matching ships with a lexical embedding - no dependency, and no idea
# that "car" and "automobile" are the same thing. A real sentence model goes in
# ~/.fam/embed (per-machine, beside the voices) and is switched on with
# FAM_EMBED_BACKEND=onnx. Neither belongs here: one is a machine's business,
# and the other has never been run - see PROBLEMS.md 68.
CANONICAL_KEY_MODEL=claude-haiku-4-5

# Where the twelve databases live.
#
# Leave these unset and each file sits in the project root, found the same way
# however the server was started. That is the right answer on a laptop, and it
# is why there is no value here to copy: a default that named a directory would
# be wrong on every machine but the one it was written on.
#
# Set them only to move the data somewhere else - a mounted disk, a backed-up
# volume - and then **use absolute paths**. A relative value is resolved
# against the project root rather than the working directory, and says so in
# the log, but it buys you nothing over leaving it unset.
#
# The Dockerfile sets every one of them to /data/... so they survive a
# redeploy, and `/api/health` reports `storage` - which of them are
# actually on a separate volume on the machine serving you, measured
# rather than read back off this file.
#
# CACHE_PATH=/data/scripts.db          # shared script cache; regenerable, costs money
# MYFAM_DB=/data/myfam.db              # interaction log; NOT regenerable
# SOCIAL_DB=/data/social.db            # names, handles, echoes; NOT regenerable
# MIXES_DB=/data/mixes.db              # DailyFAM mixes; NOT regenerable
# ATTACHMENTS_PATH=/data/attachments.db  # extracted attachment text; 6-hour TTL
# ACCOUNTS_DB=/data/accounts.db        # password hashes, identities, sessions; NOT regenerable
# QUOTAS_DB=/data/quotas.db            # per-listener allowance counters; regenerable
#                                      # (losing it hands everybody a fresh allowance,
#                                      #  which costs money and breaks nothing)
# PREFS_DB=/data/preferences.db        # interests, language, recap setting; NOT regenerable
# METERING_DB=/data/metering.db        # per-listener usage and cost; NOT regenerable
#                                      # this one is the billing record. Losing it loses
#                                      # the answer to what anything cost.
# MESSAGES_DB=/data/messages.db        # conversations in Your FAM; NOT regenerable
# SAVED_DB=/data/saved.db              # Save for Later shelves; NOT regenerable
# SHARES_DB=/data/shares.db            # /s/<id> share links and their open counts;
#                                      # NOT regenerable - losing it breaks every link
#                                      # anybody has already posted anywhere
# FEEDBACK_DB=/data/feedback.db        # Instant feedback bug reports and whether each
#                                      # is resolved; NOT regenerable
# CONSENT_DB=/data/consent.db          # who agreed to their words going to the AI
#                                      # provider (5.1.2(i)); NOT regenerable
# MODERATION_DB=/data/moderation.db    # content reports, blocks, suspensions and
#                                      # episodes taken off Explore; NOT regenerable

# Pacing
TARGET_WPM=150
MIN_WPM=115
MAX_WPM=185

# Server
HOST=0.0.0.0
PORT=8000
RATE_LIMIT_SECONDS=3
# How many of those seconds may be spent at once, so a listener who taps twice
# - switching voice, or tapping an episode that is still loading - is not
# refused. The sustained rate is unchanged.
RATE_LIMIT_BURST=3

# ---------------------------------------------------------------------------
# The public API: tiers, limits and sign-in
# ---------------------------------------------------------------------------
#
# Tier limits are enforced by default. What is behind them is a GPU and a
# metered API key reachable by anyone who has the URL, and a ceiling that has
# to be switched on is a ceiling that is off on the machine nobody checked.
#
# `demo.sh` turns this off for a local demo and says so on the way past -
# judging the writing must not stop after five episodes.
# The tier system is built and deliberately not switched on: every limit,
# counter and refusal exists, and none of them refuses anybody while this is 0.
# Turn it to 1 the day there is a way to pay past a refusal. Generation is
# still paced per listener, and every episode is still metered.
ENFORCE_QUOTAS=0

# What each tier allows. These are numbers to start a free beta with, not
# numbers anybody has measured: `python tools/usage_report.py` prints the
# median and p99 cost per listener, and the first real setting of these should
# come from that report. On the one measured run the worst listener cost 68x
# the median.
#
# Episodes are counted separately from Explore replays because they cost
# differently: an episode may write a script (a Claude call), while a replay
# provably cannot - the pipeline refuses - so it costs GPU seconds and nothing
# else. -1 anywhere means no ceiling.
#
# Free is capped per day and Plus per week on purpose: a daily cap tells the
# listener enjoying it most to come back tomorrow, which is acceptable for a
# free tier and is the wrong way to treat somebody who is paying.
# FREE_EPISODES_PER_DAY=5
# FREE_EXPLORE_PER_DAY=25
# PLUS_EPISODES_PER_WEEK=150
# PLUS_EXPLORE_PER_WEEK=-1

# Where this server is reachable from the internet, for share links.
#
# **Usually leave this unset.** Since §114 the host is read off the request
# that asked - `X-Forwarded-Proto` and `X-Forwarded-Host`, which is what
# Render's router sets - so sharing works on a deployment nobody configured.
# It had to be, because nothing anywhere prompted for this variable, so no
# deployment had it and every share link came back as `/s/abc123`: a correct
# relative URL and a useless thing to send somebody.
#
# Set it only when the host people reach is NOT the one this service answers
# on - a custom domain in front of the Render URL. Then it wins outright.
# A loopback host is still refused either way: a link naming `localhost`
# looks like a URL, so it gets posted, and it resolves on the recipient's own
# machine. `/api/health` reports which of the three happened as `link_host`.
# PUBLIC_BASE_URL=https://familiarize.net

# The app's own address: where an invite from the Friends page sends a
# friend, whatever host the page is open on (a preview, a Render URL), and
# what a referral link names when the request names no public host.
APP_HOME_URL=https://familiarize.net

# Where a share recipient goes when they press anything on the landing page
# that is not play. Unset until the app ships, and deliberately so: the
# landing page draws no "get the app" control at all rather than one that
# opens a 404, which is the same rule PUBLIC_BASE_URL above keeps. SHARING.md
# has the whole of it.
# APP_STORE_URL=https://apps.apple.com/app/fam/id0000000000

# The photo check (image_check.py): every profile picture and mix cover is
# looked at once, by one model call, for nudity, violence and hate symbols
# before other people can see it - about $0.0002 a photo on Haiku. With no
# key the photo goes through unchecked and the log says so. 0 turns it off.
IMAGE_CHECK=1
IMAGE_CHECK_MODEL=claude-haiku-5-5
IMAGE_CHECK_MAX_TOKENS=2000
IMAGE_CHECK_TIMEOUT_SECONDS=12

# Where a person reads reports and questions about the community rules. It
# is printed on /terms and in the report sheet; App Store review (guideline
# 1.2) needs a published contact, so set it before submitting.
# SUPPORT_EMAIL=support@familiarize.net
# Who is emailed when a report arrives (moderation.ReportAlerts), so the
# 24-hour promise does not rest on remembering to open /admin. Unset, the
# SUPPORT_EMAIL address is told; with neither, nobody is and /api/health says
# so. Needs mail delivery (SMTP_HOST, MAIL_FROM above).
# MODERATION_EMAIL=moderation@familiarize.net

# The iOS app's identity (APP_STORE.md). With both set, the server answers
# /.well-known/apple-app-site-association so a shared /s/ or /m/ link opens
# the app instead of Safari, and the app can offer saved FAM passwords.
# Unset, that file is a 404 rather than a promise about an app that does not
# exist. The Team ID is on developer.apple.com under Membership; the bundle
# id also belongs in APPLE_CLIENT_IDS for Sign in with Apple.
# APPLE_TEAM_ID=ABCDE12345
# IOS_BUNDLE_ID=net.familiarize.fam
# Sign in with Apple's server key (apple_tokens.py, APP_STORE.md): a key with
# "Sign in with Apple" enabled, from Certificates, Identifiers & Profiles >
# Keys. With APPLE_TEAM_ID, a deleted account's Apple sign-in is revoked, as
# guideline 5.1.1(v) requires. APPLE_PRIVATE_KEY is the .p8 file's text (one
# line with \n is fine) and is a credential: FAM_SECRETS or the dashboard.
# APPLE_KEY_ID=ABC123DEFG
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# The pre-launch waitlist (WAITLIST.md). 1 closes the app to anybody whose
# account is not active: guests and waitlisted accounts are sent to /waitlist
# and every new account starts on the list. 0 is the app as it was; launch is
# setting it back to 0.
WAITLIST=0
# Invite counts that unlock something on the waitlist status page.
WAITLIST_UNLOCKS=1,3,5
# How many new invites one invite code may credit in an hour (0 = no cap).
# Signups are not verified, so this is what stops a script buying the front
# of the line; people past the cap still join.
WAITLIST_REFERRALS_PER_HOUR=20
# Viral Loops (referral tracking, fraud checks, email). Server-only: the token
# never reaches a browser. Unset, calls wait in the outbox until it is set.
# VIRAL_LOOPS_CAMPAIGN_ID=
# VIRAL_LOOPS_API_TOKEN=

# Browser origins allowed to call this server, comma separated. Empty means
# same-origin only, which is what a localhost run and the bundled interface
# want. A native app is not a browser, sends no Origin, and needs nothing here.
#
# Deliberately never "*": these requests carry the session cookie, and a
# browser refuses a wildcard together with credentials - so it would look
# permissive, not work, and hide the real fix.
# API_ORIGINS=https://app.example.com

# Sign in with Google and Sign in with Apple. Each is the audience a provider
# identity token must name - the iOS bundle id, plus any web client id, comma
# separated. Empty means that provider is switched off, and /api/health says
# which and why rather than the button failing when somebody presses it.
#
# Verifying the token needs `pip install -r requirements-oauth.txt`. Without
# it sign-in is unavailable and says so; it never falls back to accepting a
# token it could not check, because an unverified JWT is not a weak credential,
# it is anybody's credential.
# GOOGLE_CLIENT_IDS=com.yourcompany.fam,1234-abc.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.yourcompany.fam

# Which deployment this is (STAGING.md, §172): `staging` or `production`.
# `staging` means zero spend and cannot be switched out of it - every paid key
# is removed, keyless sources (GDELT, Polymarket) are off, FAM_SECRETS is not
# consulted, and no connection leaves the machine. Episodes are the sample
# script in a placeholder tone. Unset on a laptop.
# FAM_ENV=staging
#
# Zero spend anywhere else - a laptop, a load test - without calling it staging.
# ZERO_SPEND=1

# §243: every store in Postgres instead of a SQLite file (POSTGRES.md). Unset,
# nothing changes. On staging it must be the staging database's private
# address, wired by render.yaml - never typed, never public.
# DATABASE_URL=
# Most server connections one process holds (a pool shared by every store).
# Keep instances x this under the database plan's connection limit.
# DATABASE_MAX_CONNECTIONS=20
# §254: the server refuses to start when the disk has accounts and Postgres
# has none - the copy (tools/sqlite_to_postgres.py --yes) has not run. Set to
# start on an empty database on purpose (a staging database begun clean).
# DATABASE_ALLOW_EMPTY=1
